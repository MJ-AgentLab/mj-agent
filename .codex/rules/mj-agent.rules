# Native cooperative rules; a prompt is not Owner approval.
prefix_rule(pattern=["Remove-Item"], decision="prompt")
prefix_rule(pattern=["git", "checkout", "-b"], decision="forbidden")
prefix_rule(pattern=["git", "switch", "-c"], decision="forbidden")
prefix_rule(pattern=["gh", "pr", "merge"], decision="forbidden")
prefix_rule(pattern=["psql"], decision="forbidden")
prefix_rule(pattern=["pg_dump"], decision="forbidden")
prefix_rule(pattern=["pg_restore"], decision="forbidden")
prefix_rule(pattern=["git", "commit"], decision="prompt")
prefix_rule(pattern=["git", "push"], decision="prompt")
prefix_rule(pattern=["gh", "pr", "create"], decision="prompt")
