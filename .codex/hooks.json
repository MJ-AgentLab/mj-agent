{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -EncodedCommand ",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
