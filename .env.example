##########################
### 0. Application Config ###
##########################

# Application environment (development/test/production)
MJ_AGENT_ENV=development
MJ_AGENT_DEBUG=true
MJ_AGENT_LOG_LEVEL=debug

# Database profile (dev/test/prod) - selects POSTGRES_{PROFILE}_HOST/PORT
MJ_CONFIG_PROFILE=dev

##########################
### 1. Database Info ###
##########################

# PostgreSQL - admin credentials (kept for naming consistency with mj-system; ADR-008).
# mj-agent runtime does NOT use this account - leave blank, never put admin creds here.
# (mj-agent has its own secrets pipeline; this slot is purely a convention placeholder.)
POSTGRES_USER=
POSTGRES_PASSWORD=

# PostgreSQL - dev environment connection
POSTGRES_DEV_HOST=localhost
POSTGRES_DEV_PORT=5432

# PostgreSQL - test environment connection (ask the team)
POSTGRES_TEST_HOST=192.168.0.179
POSTGRES_TEST_PORT=5432

# PostgreSQL - prod environment connection (ask the team)
POSTGRES_PROD_HOST=192.168.0.106
POSTGRES_PROD_PORT=5432

# PostgreSQL - read-only analyst account (mj-agent runtime account, ADR-006 / ADR-009)
# Injected by scripts/setup-env.ps1 from config/secrets.enc
POSTGRES_ANALYST_USER=
POSTGRES_ANALYST_PASSWORD=

# Database name mj-agent connects to (mj-system biz database)
POSTGRES_BIZ_DB=mj_system_db

# Biz-domain schema allowlist (aligned with mj-system R__analyst_permissions.sql)
# - biz_dws: analyst can SELECT all tables
# - biz_dwd: analyst can SELECT only the 2 dimension tables in BIZ_ALLOWED_DWD_TABLES
BIZ_ALLOWED_SCHEMAS=biz_dws,biz_dwd

# Table-level allowlist for biz_dwd. mj-system contract exposes exactly
# these two dimension tables; the L1 guardrail rejects any other biz_dwd.*
# reference even though the schema is in BIZ_ALLOWED_SCHEMAS.
BIZ_ALLOWED_DWD_TABLES=dwd_dim_product_interface,dwd_dim_institution

##########################
### 2. LLM Provider (multi-provider abstraction; ADR-027) ###
##########################

# mj-agent supports two providers (selected by LLM_PROVIDER):
#   - ark                  : Volcengine Ark (OpenAI-compatible) + DeepSeek V3 (default)
#   - local-openai-compat  : DGX-Spark local LLM (vLLM / SGLang / Ollama / TGI / llama.cpp)
#
# DGX-Spark is the team's local LLM compute node (192.168.0.189). LLM serving
# deployment 责任另议（mj-agent 仅消费侧）. NOTE: the serving endpoint binds
# DGX loopback ONLY — LAN-direct http://192.168.0.189:8000/v1 does NOT work
# (evidence: capabilities/data-agent/llm-provider/evidence/runtime/
# 2026-07-03_dgx_e2e.md). Consumption goes through an owner-run SSH tunnel,
# bound 0.0.0.0 so Docker containers can reach it too:
#   ssh -L 0.0.0.0:18000:127.0.0.1:8000 <user>@192.168.0.189
#   (Windows firewall prompt: allow on private networks)
# To switch to DGX vLLM:
#   LLM_PROVIDER=local-openai-compat
#   LLM_BASE_URL=http://host.docker.internal:18000/v1
#       (Docker Desktop resolves host.docker.internal on the host AND inside
#        containers — one URL covers `uv run` and compose runs alike; plain
#        Linux docker engine lacks it: use extra_hosts host-gateway there)
#   LLM_API_KEY=<real-key>                       (TEST/PROD 必填；vLLM 应启用 --api-key)
#                                                 EMPTY 仅限本地隔离 DEV
#   LLM_MODEL_ID=<vLLM --served-model-name>      (must match endpoint loaded model)
#
# Before switching: run `/mj-agent-infra-llm-endpoint-probe` to verify
# reachability + LLM_MODEL_ID match + 1-token chat smoke (Ollama fallback /api/tags).
#
# Failure semantics:
#   - ark + missing ARK_API_KEY (or LLM_API_KEY) -> LLMConfigError fail-fast
#   - local-openai-compat + missing LLM_BASE_URL -> LLMConfigError fail-fast
LLM_PROVIDER=ark

# Generic LLM endpoint + key (used when LLM_PROVIDER=local-openai-compat;
# also accepted by ark provider as override of ARK_BASE_URL/ARK_API_KEY).
LLM_BASE_URL=
LLM_API_KEY=

# Model id (passed to ChatOpenAI's model param; both providers).
LLM_MODEL_ID=deepseek-v3-2-251201

# DeepSeek deep-thinking switch (Ark provider only -- vLLM/SGLang/Ollama do
# not accept Ark's `extra_body.thinking` parameter, ignored under
# local-openai-compat). Phase 0 default off (tool-calling stability first);
# flip to true only for short reasoning-quality A/B experiments.
LLM_THINKING_ENABLED=false

# Client timeout (seconds). DB-side analyst role has statement_timeout=60s; keep headroom on the LLM side.
LLM_TIMEOUT_SEC=120

# Proxy bypass — consumed implicitly by httpx under ChatOpenAI (no code reads
# it explicitly). On Clash/v2ray machines, requests to localhost / the DGX
# tunnel get routed into the system proxy and die with 502/ConnectError
# unless excluded here. The bundle's dgx profile overrides this with a longer
# list (adds host.docker.internal + 192.168.0.189); harmless when no proxy is set.
NO_PROXY=localhost,127.0.0.1,::1

# --- Ark-specific (used when LLM_PROVIDER=ark; preserved for back-compat) ---
# Ark OpenAI-compatible endpoint (public path approved by compliance).
# Compliance path: Ark enterprise contract + ZDR (confirmed by compliance team).
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Ark API key (injected by setup-env.ps1 from secrets.enc; left blank in .env.example)
ARK_API_KEY=

##########################
### 3. Observability ###
##########################

# LangSmith (optional; Phase 0 does not require it)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=mj-agent-dev
# Injected by setup-env.ps1 from secrets.enc
LANGSMITH_API_KEY=

##########################
### 4. Runtime Limits ###
##########################

# execute_sql per-call row cap (rows beyond this are truncated; truncated=True is set in the result)
SQL_MAX_ROWS=500

# execute_sql client-side timeout (seconds). DB-side analyst role already SETs statement_timeout='60s';
# this is a client-side fuse and must not exceed 60.
SQL_STATEMENT_TIMEOUT_SEC=60

##########################
### 5. Memory storage (mj-agent-owned) ###
##########################

# Storage-stack PR moves the memory checkpointer DB onto a dedicated
# mj-agent postgres container (NOT the mj-system biz pg). For local /
# non-Docker dev, point HOST/PORT at any postgres you own; for Docker
# deployment the compose file overrides HOST=mj-agent-postgres.
#
# Bootstrap is automatic in Docker (docker/postgres-init/
# 01-bootstrap-mj-agent-memory.sh runs on first container start and
# creates DB + role + GRANT). For non-Docker dev, run the SQL block in
# src/mj_agent/memory/migrations/001_checkpoint_tables.sql DBA pre-flight
# manually against your postgres.
#
# Port mapping (default targets storage-stack; override only for bare-metal):
#   - storage-stack mj-agent-postgres (host)  : MJ_AGENT_MEMORY_PORT=5433  <- default
#   - bare-metal pg on dev box (rare)         : MJ_AGENT_MEMORY_PORT=5432
#     (compose maps host 5433 -> container 5432 to avoid clashing with
#     mj-system mj-postgres which already binds host 5432; inside the
#     mj-agent container the compose override sets HOST=mj-agent-postgres
#     + PORT=5432 via service DNS, so this var only matters when the
#     application runs OUTSIDE the compose network — i.e. local dev /
#     LangGraph Studio against the storage-stack containers.)

MJ_AGENT_MEMORY_HOST=localhost
MJ_AGENT_MEMORY_PORT=5433
MJ_AGENT_MEMORY_DB=mj_agent_memory

# Memory DB user/password (read-write; distinct from analyst).
# Role name `mj_agent_app` is the runtime application account (RW on
# mj_agent_memory DB only); pairs with `analyst` (RO on biz DB) on the
# same machine. DB name stays `mj_agent_memory` — only the role rename'd.
# Team-distributed via secrets.enc — `scripts/setup-env.ps1` overwrites
# the placeholders below with the encrypted bundle's values. The
# placeholder is a fallback for developers who can't run setup-env.ps1
# (no team password); they get a working DEV setup with `mj_agent_app`
# / `local-dev-only-replace-in-prod` and the mj-agent-postgres init
# script will CREATE ROLE matching whatever values land in .env at
# `docker compose up` time.
MJ_AGENT_MEMORY_USER=mj_agent_app
MJ_AGENT_MEMORY_PASSWORD=local-dev-only-replace-in-prod

# Connection pool max size for checkpointer.
MJ_AGENT_MEMORY_POOL_MAX=10

# Memory postgres SUPERUSER password (compose-only; NOT read by Python).
# docker/compose.yaml passes ${MJ_AGENT_PG_SUPERUSER_PASSWORD:-local-dev-only-replace}
# to the mj-agent-postgres container's POSTGRES_PASSWORD (postgres-init +
# healthcheck run as this superuser). Left blank, the compose `:-` fallback
# bakes the placeholder into the volume on FIRST init — fine for throwaway
# DEV, replace for anything shared. PG stores it in the volume at init time;
# changing it later needs the rotation runbook in config/README.md (env
# edits alone do nothing post-init).
MJ_AGENT_PG_SUPERUSER_PASSWORD=

##########################
### 5b. Redis (mj-agent-owned; future use) ###
##########################

# Redis container ships with the storage stack but no Python client is
# wired yet. Settings are declared so future features (session cache /
# streaming buffers / rate limit) can pick them up without a config
# migration. Empty MJ_AGENT_REDIS_HOST disables — current code ignores.
MJ_AGENT_REDIS_HOST=
MJ_AGENT_REDIS_PORT=6379
MJ_AGENT_REDIS_PASSWORD=

##########################
### 6. Chainlit UI (Phase 1 sub 1.A) ###
##########################

# Bind address for `mj-agent serve` / `chainlit run src/mj_agent/ui.py`.
# Default 127.0.0.1 keeps the UI on loopback; override to 0.0.0.0 in
# Docker / DEV deployment (Phase 1 sub 1.H).
CHAINLIT_HOST=127.0.0.1
CHAINLIT_PORT=8000

##########################
### 7. Chart / Excel artifact tmpdir (Phase 1 sub 1.F) ###
##########################

# Directory for matplotlib PNG + openpyxl .xlsx outputs. Auto-created if
# missing. Defaults to OS temp under "mj-agent-charts/" when unset; override
# to a persistent path if you want to inspect chart history.
MJ_AGENT_CHART_TMPDIR=

# ---------------------------------------------------------------------
# MCP infrastructure secrets (SSH passwords + remote PG URLs) are managed
# in a SEPARATE encrypted bundle per ADR-030:
#
#   Bundle:  config/secrets-mcp.enc
#   Schema:  config/secrets-mcp.example  (5 SSH + 10 PG URL = 15 keys)
#   Setup:   .\.claude\scripts\setup-mcp-secrets.ps1
#   Target:  OS User-level env (HKCU\Environment) — never written to .env
#
# Rationale: ${VAR} substitution in .mcp.json is evaluated by claude.exe
# at startup from OS env; mj-agent Python runtime / docker compose do not
# read MCP secrets. Keeping them out of .env reduces magnetic-disk plaintext
# exposure and aligns with mj-system v2.3 secrets-sys-ops.enc trust boundary.
# ---------------------------------------------------------------------
