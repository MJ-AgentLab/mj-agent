##########################
### 0. Application Config ###
##########################

# 应用环境 (development/test/production)
MJ_AGENT_ENV=development
MJ_AGENT_DEBUG=true
MJ_AGENT_LOG_LEVEL=debug

# 数据库 profile (dev/test/prod) - 决定 POSTGRES_{PROFILE}_HOST 的解析
MJ_CONFIG_PROFILE=dev

##########################
### 1. Database Info ###
##########################

# PostgreSQL - 认证信息 (与 mj-system 保持同名, 便于 co-deployment 合并 .env)
# mj-agent 运行时不使用此账号 - 保持空值, 切勿填入 admin 凭据
POSTGRES_USER=
POSTGRES_PASSWORD=

# PostgreSQL - 开发环境连接配置
POSTGRES_DEV_HOST=localhost
POSTGRES_DEV_PORT=5432

# PostgreSQL - 测试环境连接配置 (向团队获取)
POSTGRES_TEST_HOST=192.168.0.179
POSTGRES_TEST_PORT=5432

# PostgreSQL - 生产环境连接配置 (向团队获取)
POSTGRES_PROD_HOST=192.168.0.106
POSTGRES_PROD_PORT=5432

# PostgreSQL - 数据分析只读账号 (mj-agent 运行时实际使用的账号, ADR-006 / ADR-009)
# 由 scripts/setup-env.ps1 从 config/secrets.enc 解密注入
POSTGRES_ANALYST_USER=
POSTGRES_ANALYST_PASSWORD=

# mj-agent 连接的数据库名 (mj-system 的业务库)
POSTGRES_BIZ_DB=mj_system_db

# biz 域 schema allowlist (与 mj-system/sql/migrations/repeatable/R__analyst_permissions.sql 对齐)
# - biz_dws: analyst 可 SELECT 全部表
# - biz_dwd: analyst 仅可 SELECT dwd_dim_product_interface / dwd_dim_institution (DB GRANT 兜底)
BIZ_ALLOWED_SCHEMAS=biz_dws,biz_dwd

##########################
### 2. LLM Provider (Volcengine Ark) ###
##########################

# mj-agent 仅使用火山方舟 (Ark) 的 OpenAI 兼容端点 + DeepSeek V3 作为 LLM
# provider。没有 ARK_API_KEY 时 agent 启动直接报错 (fail fast, 无静默降级)。
# 合规路径: Ark 企业协议 + ZDR (合规团队已确认)。

# Ark 模型名 (直接透传给 ChatOpenAI 的 model 参数)
LLM_MODEL_ID=deepseek-v3-2-251201

# DeepSeek 深度思考开关。Phase 0 默认关闭 (tool-calling 稳定性优先);
# 做推理质量对比实验时临时置 true
LLM_THINKING_ENABLED=false

# 客户端超时 (秒)。DB 侧 analyst 角色 statement_timeout=60s, LLM 端留余量
LLM_TIMEOUT_SEC=120

# Ark OpenAI 兼容端点 (公网路径由合规批准)
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Ark API Key (由 setup-env.ps1 从 secrets.enc 注入; .env.example 留空)
ARK_API_KEY=

##########################
### 3. Observability ###
##########################

# LangSmith (可选, Phase 0 不强制开启)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=mj-agent-dev
# key 由 setup-env.ps1 从 secrets.enc 注入
LANGSMITH_API_KEY=

##########################
### 4. Runtime Limits ###
##########################

# execute_sql 单次返回上限 (超过则截断并标记 truncated=True)
SQL_MAX_ROWS=500

# execute_sql 客户端超时 (秒) - DB 侧 analyst 角色已 SET statement_timeout='60s',
# 此值仅作为客户端侧辅助熔断,不应大于 60
SQL_STATEMENT_TIMEOUT_SEC=60
