# mj-agent MCP Infrastructure Secrets — 15 variables (decrypt -> HKCU\Environment, never to .env)
# Copy to secrets-mcp.conf, fill values, run .\scripts\encrypt-secrets-mcp.ps1
#
# Per ADR-030 bundle split: these 15 secrets are decrypted by
# .\.claude\scripts\setup-mcp-secrets.ps1 and written directly to OS
# User-level env (HKCU\Environment), bypassing .env entirely. .mcp.json
# ${VAR} substitution resolves at claude.exe startup from OS env.
#
# 填哪些看你要连哪些主机/库（对 app 启动零影响）：SSH 连哪台填哪台；PG WAN×4
# 要用则必填（无 fallback），LAN×6 可空（有 .mcp.json 占位但连不上真库）。
# 完整分类见 config/README.md 「## secrets.conf 填写指南」（SoT）。

# §1 SSH Server Passwords (5 unique values drive 9 ssh-manager entries:
# cloud + 4 hosts x 2 lan/wan; lan + wan share password per host)
MJ_AGENT_SSH_SERVER_CLOUD_PASSWORD=
MJ_AGENT_SSH_SERVER_RUNNER_PASSWORD=
MJ_AGENT_SSH_SERVER_TEST_PASSWORD=
MJ_AGENT_SSH_SERVER_PROD_PASSWORD=
MJ_AGENT_SSH_SERVER_DGX_PASSWORD=

# §2 PostgreSQL Connection URLs for .mcp.json pg-server wrapper (10 entries:
# 5 memory checkpointer DB + 5 biz pg via analyst RO).
# LAN URLs have placeholder fallbacks in .mcp.json; WAN URLs (FRP-tunneled)
# require these values otherwise the MCP server fails to start.
MJ_AGENT_PG_MEMORY_DEV_URL=
MJ_AGENT_PG_MEMORY_TEST_LAN_URL=
MJ_AGENT_PG_MEMORY_TEST_WAN_URL=
MJ_AGENT_PG_MEMORY_PROD_LAN_URL=
MJ_AGENT_PG_MEMORY_PROD_WAN_URL=
MJ_AGENT_PG_BIZ_DEV_URL=
MJ_AGENT_PG_BIZ_TEST_LAN_URL=
MJ_AGENT_PG_BIZ_TEST_WAN_URL=
MJ_AGENT_PG_BIZ_PROD_LAN_URL=
MJ_AGENT_PG_BIZ_PROD_WAN_URL=
