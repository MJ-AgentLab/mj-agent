# mj-agent Secrets — application-level variables across 6 sections
# Independent from mj-system (separate password, separate secrets.enc).
# Copy to secrets.conf, fill values, run .\scripts\encrypt-secrets.ps1

# §1 Database — analyst read-only role for biz queries (ADR-006 L4)
POSTGRES_ANALYST_USER=
POSTGRES_ANALYST_PASSWORD=

# §2 LLM Provider — Volcengine Ark (fail-fast if LLM_PROVIDER=ark and missing)
ARK_API_KEY=

# §2b LLM Provider — local OpenAI-compatible endpoint (DGX vLLM/SGLang/Ollama;
# PR-2 ADR-025; only required when LLM_PROVIDER=local-openai-compat AND the
# remote endpoint requires auth — typically blank for unauthenticated vLLM,
# fill in if vLLM started with --api-key)
LLM_API_KEY=

# §3 Observability (optional; leave blank if LANGSMITH_TRACING=false)
LANGSMITH_API_KEY=

# §4 Memory checkpointer — mj-agent-owned postgres (storage-stack PR)
# Read-write role for langgraph PostgresSaver. Distinct from POSTGRES_ANALYST_*
# (analyst is RO on biz; this is RW on mj_agent_memory DB only). The
# postgres-init script (infra/docker/postgres-init/01-bootstrap-mj-agent-memory.sh)
# uses these values verbatim to CREATE ROLE on the mj-agent-postgres container's
# first init.
MJ_AGENT_MEMORY_USER=
MJ_AGENT_MEMORY_PASSWORD=

# §5 SSH passwords for ssh-manager MCP server (PR-3; STANDARD_MCP_Server_Governance §5)
# 5 unique passwords drive 9 ssh-manager entries (cloud + 4 hosts x 2 lan/wan).
# Independent namespace per ADR-008 — DO NOT reuse mj-system's MJ_SYS_SSH_*.
MJ_AGENT_SSH_SERVER_CLOUD_PASSWORD=
MJ_AGENT_SSH_SERVER_RUNNER_PASSWORD=
MJ_AGENT_SSH_SERVER_TEST_PASSWORD=
MJ_AGENT_SSH_SERVER_PROD_PASSWORD=
MJ_AGENT_SSH_SERVER_DGX_PASSWORD=

# §6 .mcp.json postgres URL overrides (PR-3; optional — defaults baked into .mcp.json
# point at localhost / LAN with REPLACE_WITH_TEAM_*_PASSWORD placeholders;
# WAN URLs (no fallback) required when accessing remote pg over FRP tunnels)
MJ_AGENT_PG_MEMORY_DEV_URL=
MJ_AGENT_PG_MEMORY_TEST_LAN_URL=
MJ_AGENT_PG_MEMORY_TEST_WAN_URL=
MJ_AGENT_PG_MEMORY_PROD_LAN_URL=
MJ_AGENT_PG_MEMORY_PROD_WAN_URL=
MJ_AGENT_PG_BIZ_DEV_URL=
MJ_AGENT_PG_BIZ_TEST_LAN_URL=
MJ_AGENT_PG_BIZ_TEST_WAN_URL=
MJ_AGENT_PG_BIZ_PROD_LAN_URL=
MJ_AGENT_PG_BIZ_PROD_WAN_URL=
