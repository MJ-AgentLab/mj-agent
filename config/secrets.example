# mj-agent App Secrets — application-level secrets + persisted non-secret
# overrides (ADR-030 bundle split).
# Independent from mj-system (separate password, separate secrets.enc).
# Copy to secrets.conf, fill values, run .\scripts\encrypt-secrets.ps1
#
# NOTE per ADR-030: MCP infrastructure secrets (5 SSH passwords + 10 PG URLs)
# are managed in a SEPARATE bundle config/secrets-mcp.enc (schema:
# config/secrets-mcp.example; setup: .\.claude\scripts\setup-mcp-secrets.ps1).
# Both .enc files use the same team password but are decrypted by different
# scripts to different targets (.env vs OS User-level env).
#
# 每个字段该填 / 留空 / 照抄的分类见 config/README.md 「## secrets.conf 填写指南」
# （SoT）。速记：必填 = §1 analyst + §2 ARK + §4 memory；可空 = §2b/§3/§4b；
# §2c profile 照抄预填（唯 ARK__LLM_BASE_URL 强制留空——填了会误打端点）。

# §1 Database — analyst read-only role for biz queries (ADR-006 L4)
POSTGRES_ANALYST_USER=
POSTGRES_ANALYST_PASSWORD=

# §2 LLM Provider — Volcengine Ark (fail-fast if LLM_PROVIDER=ark and missing)
ARK_API_KEY=

# §2b LLM Provider — local OpenAI-compatible endpoint (DGX vLLM/SGLang/Ollama;
# ADR-027; only required when LLM_PROVIDER=local-openai-compat AND the
# remote endpoint requires auth — typically blank for unauthenticated vLLM,
# fill in if vLLM started with --api-key)
LLM_API_KEY=

# §2c LLM provider profiles (non-secret persistence; ADR-027 switch +
# ADR-030 pipeline + #297 profile mechanism) — carried in the bundle so
# setup-env.ps1 regeneration keeps the active provider instead of
# resetting to .env.example's ark default.
#
# TWO named sets; `.\scripts\setup-env.ps1 -LlmProfile <ark|dgx>` resolves
# exactly ONE of them onto the plain keys (LLM_PROVIDER / LLM_BASE_URL /
# LLM_MODEL_ID / NO_PROXY) at .env generation time. Selection precedence:
# -LlmProfile param > LLM_PROFILE_DEFAULT > the only non-empty set >
# interactive prompt. Namespaced keys never land in .env; empty values
# inside the selected set are skipped (template defaults win).
LLM_PROFILE_DEFAULT=

# -- profile: ark — Volcengine Ark cloud; works on ANY machine, no extra
#    prerequisites. NO_PROXY keeps localhost off Clash/v2ray proxies.
#    ⚠ LLM_BASE_URL 必须留空（空值→跳过注入→回落 ARK_BASE_URL 官方端点）。
#    填了别的（如 DGX 隧道地址）= ark 套实际打到那个端点：vLLM 会回
#    "The model `deepseek-v3-2-251201` does not exist"（#297 现场事故）。
LLM_PROFILE_ARK__LLM_PROVIDER=ark
LLM_PROFILE_ARK__LLM_BASE_URL=
LLM_PROFILE_ARK__LLM_MODEL_ID=deepseek-v3-2-251201
LLM_PROFILE_ARK__NO_PROXY=localhost,127.0.0.1,::1,ark.cn-beijing.volces.com

# -- profile: dgx — local-openai-compat via the owner-run SSH tunnel.
#    vLLM binds DGX loopback ONLY (LAN-direct 192.168.0.189:8000 does NOT
#    work). Machine prerequisites:
#      1) Docker Desktop — provides host.docker.internal on the host AND
#         inside containers, so ONE base-url covers `uv run` and compose;
#      2) tunnel bound 0.0.0.0 so containers can reach it:
#         ssh -L 0.0.0.0:18000:127.0.0.1:8000 <user>@192.168.0.189
#    LLM_MODEL_ID must match the endpoint's --served-model-name (ADR-033).
LLM_PROFILE_DGX__LLM_PROVIDER=local-openai-compat
LLM_PROFILE_DGX__LLM_BASE_URL=http://host.docker.internal:18000/v1
LLM_PROFILE_DGX__LLM_MODEL_ID=nemotron-3-super
LLM_PROFILE_DGX__NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,192.168.0.189,ark.cn-beijing.volces.com

# Legacy plain §2c keys (LLM_PROVIDER= / LLM_BASE_URL= / LLM_MODEL_ID= /
# NO_PROXY=) are still honored when no LLM_PROFILE_* keys are present
# (old bundles); when profiles are present, profile values win.

# §3 Observability (optional; leave blank if LANGSMITH_TRACING=false)
LANGSMITH_API_KEY=

# §4 Memory checkpointer — mj-agent-owned postgres (storage-stack PR)
# Read-write role for langgraph PostgresSaver. Distinct from POSTGRES_ANALYST_*
# (analyst is RO on biz; this is RW on mj_agent_memory DB only). The
# postgres-init script (docker/postgres-init/01-bootstrap-mj-agent-memory.sh)
# uses these values verbatim to CREATE ROLE on the mj-agent-postgres container's
# first init.
MJ_AGENT_MEMORY_USER=
MJ_AGENT_MEMORY_PASSWORD=

# §4b Memory postgres SUPERUSER (compose-only) — docker/compose.yaml passes
# ${MJ_AGENT_PG_SUPERUSER_PASSWORD:-local-dev-only-replace} to the
# mj-agent-postgres container's POSTGRES_PASSWORD (postgres-init +
# healthcheck run as this superuser). NOT a config.py Settings field —
# deliberate exemption from the three-place registration rule (Python
# never consumes it; see config/README.md). PG bakes it into the volume
# on FIRST init; changing it afterwards requires the password-rotation
# runbook in config/README.md — editing env alone does nothing post-init.
MJ_AGENT_PG_SUPERUSER_PASSWORD=
