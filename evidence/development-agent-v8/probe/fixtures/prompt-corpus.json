{
  "schema_version": 1,
  "corpus_id": "p1a-prompt-corpus-v1",
  "notes": "Implicit-trigger corpus for model-telemetry-v1. One positive and one near-negative prompt per required capability; prompts read as natural user requests and never name a skill or say 'skill'. Near-negative outcomes are observations, not failures (telemetry cannot alter the deterministic verdict, AC-09).",
  "prompts": [
    {"capability_id": "mj-agent-doc-validate", "prompt_id": "mj-agent-doc-validate--positive", "kind": "positive", "text": "帮我校验一下仓库文档的 frontmatter 和 wikilink 是否都合规，把文档验证跑一遍并汇报结果。"},
    {"capability_id": "mj-agent-doc-validate", "prompt_id": "mj-agent-doc-validate--near-negative", "kind": "near-negative", "text": "帮我解释一下这个仓库的文档治理是怎么分层组织的。"},
    {"capability_id": "mj-agent-flow-diagnose", "prompt_id": "mj-agent-flow-diagnose--positive", "kind": "positive", "text": "tests 里有个用例偶发失败，帮我系统性诊断这个 flaky 问题的根因，先建立可复现信号再下结论。"},
    {"capability_id": "mj-agent-flow-diagnose", "prompt_id": "mj-agent-flow-diagnose--near-negative", "kind": "near-negative", "text": "帮我把这个函数重构得更简洁一些，行为保持不变。"},
    {"capability_id": "mj-agent-flow-implement", "prompt_id": "mj-agent-flow-implement--positive", "kind": "positive", "text": "plan 已经批准了，现在开始按计划编码实现这个功能。"},
    {"capability_id": "mj-agent-flow-implement", "prompt_id": "mj-agent-flow-implement--near-negative", "kind": "near-negative", "text": "帮我评审一下这段已经写完的代码有没有问题。"},
    {"capability_id": "mj-agent-flow-intake", "prompt_id": "mj-agent-flow-intake--positive", "kind": "positive", "text": "我有个新需求想启动开发：给命令行工具加一个导出报表的子命令。帮我把这个想法转成结构化的工程任务。"},
    {"capability_id": "mj-agent-flow-intake", "prompt_id": "mj-agent-flow-intake--near-negative", "kind": "near-negative", "text": "现在这个分支的工作进行到哪个阶段了？"},
    {"capability_id": "mj-agent-flow-plan", "prompt_id": "mj-agent-flow-plan--positive", "kind": "positive", "text": "帮我为这个任务写一份实施 plan 正文，包括拆解、风险和验收标准。"},
    {"capability_id": "mj-agent-flow-plan", "prompt_id": "mj-agent-flow-plan--near-negative", "kind": "near-negative", "text": "把这份已经完成的 plan 文件归档掉。"},
    {"capability_id": "mj-agent-flow-post-merge", "prompt_id": "mj-agent-flow-post-merge--positive", "kind": "positive", "text": "PR 刚被人工合并了，帮我做合并后的清理、同步和收尾记录。"},
    {"capability_id": "mj-agent-flow-post-merge", "prompt_id": "mj-agent-flow-post-merge--near-negative", "kind": "near-negative", "text": "帮我创建一个新的 PR 提交这次的改动。"},
    {"capability_id": "mj-agent-flow-repo-scan", "prompt_id": "mj-agent-flow-repo-scan--positive", "kind": "positive", "text": "动手之前先做一次仓库现状扫描，核对计划和代码事实是否还对得上。"},
    {"capability_id": "mj-agent-flow-repo-scan", "prompt_id": "mj-agent-flow-repo-scan--near-negative", "kind": "near-negative", "text": "帮我给这个模块写一组单元测试。"},
    {"capability_id": "mj-agent-flow-review-respond", "prompt_id": "mj-agent-flow-review-respond--positive", "kind": "positive", "text": "reviewer 在 PR 上留了几条评审意见，帮我逐条分析并给出回应和修改。"},
    {"capability_id": "mj-agent-flow-review-respond", "prompt_id": "mj-agent-flow-review-respond--near-negative", "kind": "near-negative", "text": "提交前帮我自己先做一轮完整的自评审。"},
    {"capability_id": "mj-agent-flow-scope-drift", "prompt_id": "mj-agent-flow-scope-drift--positive", "kind": "positive", "text": "我感觉这次改动可能超出了原来批准的范围，帮我做一次范围漂移检查并给出判定。"},
    {"capability_id": "mj-agent-flow-scope-drift", "prompt_id": "mj-agent-flow-scope-drift--near-negative", "kind": "near-negative", "text": "帮我扩大这个函数的测试覆盖率。"},
    {"capability_id": "mj-agent-flow-self-review", "prompt_id": "mj-agent-flow-self-review--positive", "kind": "positive", "text": "实现完成了，提交之前帮我做一轮严格的 AI 自评审，找出潜在缺陷。"},
    {"capability_id": "mj-agent-flow-self-review", "prompt_id": "mj-agent-flow-self-review--near-negative", "kind": "near-negative", "text": "帮我回应 reviewer 在 PR 上提出的那几条意见。"},
    {"capability_id": "mj-agent-flow-verify", "prompt_id": "mj-agent-flow-verify--positive", "kind": "positive", "text": "帮我跑一遍本地验证：测试、lint、类型检查全部过一遍并汇总结果。"},
    {"capability_id": "mj-agent-flow-verify", "prompt_id": "mj-agent-flow-verify--near-negative", "kind": "near-negative", "text": "这个测试为什么会失败？帮我解释一下原因。"},
    {"capability_id": "mj-agent-git-branch", "prompt_id": "mj-agent-git-branch--positive", "kind": "positive", "text": "帮我为接下来这个任务开一个新分支和对应的工作区。"},
    {"capability_id": "mj-agent-git-branch", "prompt_id": "mj-agent-git-branch--near-negative", "kind": "near-negative", "text": "帮我看看现在在哪个分支上、工作区干不干净。"},
    {"capability_id": "mj-agent-git-commit", "prompt_id": "mj-agent-git-commit--positive", "kind": "positive", "text": "帮我把当前这些改动按逻辑拆分提交，并写好规范的 commit message。"},
    {"capability_id": "mj-agent-git-commit", "prompt_id": "mj-agent-git-commit--near-negative", "kind": "near-negative", "text": "帮我撤销上一次的提交，改动保留在工作区。"},
    {"capability_id": "mj-agent-git-delete", "prompt_id": "mj-agent-git-delete--positive", "kind": "positive", "text": "PR 已经合并了，帮我删掉这个分支并清理对应的工作区。"},
    {"capability_id": "mj-agent-git-delete", "prompt_id": "mj-agent-git-delete--near-negative", "kind": "near-negative", "text": "帮我删掉这个已经没用的源码文件。"},
    {"capability_id": "mj-agent-git-issue", "prompt_id": "mj-agent-git-issue--positive", "kind": "positive", "text": "帮我把这个 bug 的现象和复现步骤整理成一个 GitHub Issue 并创建出去。"},
    {"capability_id": "mj-agent-git-issue", "prompt_id": "mj-agent-git-issue--near-negative", "kind": "near-negative", "text": "帮我看看 issue #123 现在是什么状态、有哪些讨论。"},
    {"capability_id": "mj-agent-git-pr", "prompt_id": "mj-agent-git-pr--positive", "kind": "positive", "text": "分支已经推上去了，帮我创建一个指向 develop 的 PR，正文按模板写。"},
    {"capability_id": "mj-agent-git-pr", "prompt_id": "mj-agent-git-pr--near-negative", "kind": "near-negative", "text": "帮我合并这个已经通过评审的 PR。"},
    {"capability_id": "mj-agent-git-push", "prompt_id": "mj-agent-git-push--positive", "kind": "positive", "text": "帮我把当前分支推送到 gitee 和 github 两个远端，推送前把检查跑一遍。"},
    {"capability_id": "mj-agent-git-push", "prompt_id": "mj-agent-git-push--near-negative", "kind": "near-negative", "text": "帮我拉取远端最新的改动到本地。"},
    {"capability_id": "mj-agent-git-sync", "prompt_id": "mj-agent-git-sync--positive", "kind": "positive", "text": "把 develop 上最新的改动同步进我当前的工作分支。"},
    {"capability_id": "mj-agent-git-sync", "prompt_id": "mj-agent-git-sync--near-negative", "kind": "near-negative", "text": "帮我把工作区的改动先 stash 起来。"}
  ]
}
