+  d01q02 -> content [label="确认/改名"];
+  content -> hitl_b;
+  hitl_b -> validate [label="A/C 风味或非 in-source"];
+  hitl_b -> post [label="B 风味；HITL pause 后 user 确认"];
+  validate -> post;
+  post -> done;
+}
+```
