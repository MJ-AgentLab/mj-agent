+# Posture: warning is this gate's long-term registered stance
+# (sdd/gates.md §2, `warning@ci`); a blocking flip is NOT pursued (#440).
+# The former 4-week trial-period note was retired -- it came from the
+# now-archived ADR, was never registered per policies/ci-gates.md §4.1.1,
+# and could not be met as written (find_stale_docs.py returns 0 on every
+# path, so flipping continue-on-error alone would be a no-op).
+#
+# Runs `scripts/find_stale_docs.py` against the PR diff. Detects
+# backtick-quoted refs to renamed / deleted files in:
+#   - docs/**/*.md, plans/**/*.md
+#   - SDD kernel (#441): capabilities/ decisions/ policies/ sdd/ (*.md only)
+#   - root: README.md CONTRIBUTING.md CHANGELOG.md GLOSSARY.md AGENTS.md
+#     plus AGENTS.md
+#
+# Output goes to GitHub Actions step summary as `::warning::` annotations.
+# Always exits 0 (never blocks PR merge).
+
+on:
+  pull_request:
+    branches:
+      - develop
+      - main
+    # Trigger face = rename-SOURCE paths (which diffs warrant a run). It is
+    # NOT the same set as the script's WALK_DIRS grep-TARGET face (#441):
+    # scripts/ and .github/ hold no governed .md, but governed docs
+    # backtick-reference them heavily -- live miss: #442, the PR that
+    # registered this gate, could not trigger it. Not exhaustive by design:
+    # any path NOT listed below never triggers -- tests/, config/, docker/,
+    # evidence/, archive/ and root non-.md files among them; the residual
+    # gap is registered in the sdd/gates.md §2 row.
+    paths:
+      - 'docs/**'
+      - 'plans/**'
+      - 'src/**'
+      - '.agents/**'
+      - '.codex/**'
+      - 'capabilities/**'
+      - 'decisions/**'
+      - 'policies/**'
+      - 'sdd/**'
+      - 'scripts/**'
+      - '.github/**'
+      - 'CHANGELOG.md'
+      - 'README.md'
+      - 'CONTRIBUTING.md'
+      - 'GLOSSARY.md'
+      - 'AGENTS.md'
+
+permissions:
+  contents: read
+
+jobs:
+  check-stale-docs:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout (full history for git diff)
+        uses: actions/checkout@v7.0.1
+        with:
+          fetch-depth: 0
+
+      - name: Set up Python 3.13
+        uses: actions/setup-python@v7
+        with:
+          python-version: "3.13"
+
+      - name: Run find_stale_docs.py (warning mode)
+        run: |
+          python scripts/find_stale_docs.py "origin/${{ github.base_ref }}" HEAD | tee stale-docs.log
+          echo "::notice::find_stale_docs.py runs in warning mode by design (long-term posture; see sdd/gates.md §2). Review output above; no merge block."
+        continue-on-error: true
