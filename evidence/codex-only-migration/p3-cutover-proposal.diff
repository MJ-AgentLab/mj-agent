+
+  p1 [label="Phase 1: Classify Changes\n• git diff --name-only\n• Categorize: code/doc/.codex/config" shape=box];
+
+  p2 [label="Phase 2: §9.4 Cross-Check (mapping)\nFor each code change:\n  matching doc update exist?" shape=box];
