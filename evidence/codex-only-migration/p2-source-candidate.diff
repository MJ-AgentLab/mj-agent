-```bash
-docker exec mj-agent-postgres psql -U <MJ_AGENT_MEMORY_USER> -d mj_agent_memory -c "
-SELECT thread_id, COUNT(*) AS checkpoint_count, MAX(created_at) AS last_checkpoint
-FROM checkpoints
-GROUP BY thread_id
-ORDER BY last_checkpoint DESC
-LIMIT 10;
-"
-```
