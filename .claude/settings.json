{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "Write",
      "WebFetch",
      "mcp__*",
      "Skill",
      "Agent"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(Remove-Item*)",
      "Bash(del *)",
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)"
    ]
  },
  "enabledPlugins": {
    "mj-doc@mj-agentlab-marketplace": true,
    "mj-git@mj-agentlab-marketplace": true,
    "mj-ops@mj-agentlab-marketplace": true,
    "mj-n8n@mj-agentlab-marketplace": true
  }
}
