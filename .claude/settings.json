{
  "skillListingBudgetFraction": 0.04,
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Edit",
      "Read",
      "Write",
      "WebFetch",
      "mcp__github__*",
      "mcp__serena__*",
      "mcp__pg-mj-agent-memory-dev__*",
      "mcp__pg-mj-agent-memory-test-lan__*",
      "mcp__pg-mj-agent-memory-test-wan__*",
      "mcp__pg-mj-agent-memory-prod-lan__*",
      "mcp__pg-mj-agent-memory-prod-wan__*",
      "mcp__pg-mj-system-biz-dev__*",
      "mcp__pg-mj-system-biz-test-lan__*",
      "mcp__pg-mj-system-biz-test-wan__*",
      "mcp__pg-mj-system-biz-prod-lan__*",
      "mcp__pg-mj-system-biz-prod-wan__*",
      "mcp__ssh-manager__*",
      "mcp__playwright__*",
      "Skill",
      "Agent"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(Remove-Item*)",
      "Bash(del *)",
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./config/secrets.enc)",
      "Edit(./config/secrets.enc)",
      "Read(./config/secrets-mcp.enc)",
      "Edit(./config/secrets-mcp.enc)"
    ],
    "ask": [
      "Edit(./src/mj_agent/tools/sql/guardrail.py)",
      "Edit(./src/mj_agent/tools/sql/precheck.py)",
      "Edit(./src/mj_agent/prompts/system.md)",
      "Edit(./src/mj_agent/biz_catalog/qcm_catalog.yaml)",
      "Edit(./src/mj_agent/skills/**/SKILL.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ${CLAUDE_PROJECT_DIR}/.claude/scripts/guard-git-workflow.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-claude-md-improver/on-stop.ps1"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}