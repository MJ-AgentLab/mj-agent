# Default: let git handle line endings using its own heuristics + .editorconfig.
* text=auto

# Shell scripts MUST be LF (otherwise bash chokes on CRLF inside Linux containers).
*.sh text eol=lf

# Dockerfile: Docker BuildKit accepts CRLF, but pin LF for consistency.
Dockerfile text eol=lf
**/Dockerfile text eol=lf

# Python source: standard LF (PEP 8 / Black assumes LF).
*.py text eol=lf

# YAML / TOML / JSON: cross-tool consistency expects LF.
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Fixture patches (dual-agent-compat P2): byte-exact apply/compare requires LF.
*.patch text eol=lf

# Native development assets use deterministic LF checkouts.
.agents/** text eol=lf
.codex/** text eol=lf
scripts/mcp/** text eol=lf

# Delivery inputs must have identical checkout and committed blob bytes.
# Keep platform EOL settings from changing acceptance/dependency digests.
*.md text eol=lf
*.feature text eol=lf
*.template text eol=lf
uv.lock text eol=lf
.python-version text eol=lf
.gitattributes text eol=lf
.github/CODEOWNERS text eol=lf

