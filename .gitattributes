# Default: let git handle line endings using its own heuristics + .editorconfig.
* text=auto

# Shell scripts MUST be LF (otherwise bash chokes on CRLF inside Linux containers).
*.sh text eol=lf

# Dockerfile: Docker BuildKit accepts CRLF, but pin LF for consistency.
Dockerfile text eol=lf
**/Dockerfile text eol=lf

# Python source: standard LF (PEP 8 / Black assumes LF).
*.py text eol=lf

# YAML / TOML / JSON: cross-tool consistency expects LF.
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Fixture patches (dual-agent-compat P2): byte-exact apply/compare requires LF.
*.patch text eol=lf

# Codex carrier SKILL.md (Epic #499 PR-C1, follow-up F9). The v2 lock's
# `skill-byte-copy` entries use `normalization_policy: raw-bytes-v1` — a raw
# SHA-256 over worktree bytes with NO LF normalization, because plan §2.4/§2.6
# define byte-copy identity to include BOM/EOL and forbid normalizing it. Under
# the `* text=auto` default a Windows checkout yields CRLF while the blob stays
# LF, so `agents_sync.py sync` would mint `output_sha256`/`source_sha256` values
# that ubuntu CI cannot reproduce (blocking V10, and V9 PJ033). Pinning BOTH the
# source and the artifact side makes those raw bytes platform-deterministic
# without touching `raw-bytes-v1` semantics. Blob-neutral: `text=auto` already
# normalizes on the write-to-index path, so this changes checkout only.
.claude/skills/**/SKILL.md text eol=lf
.agents/skills/**/SKILL.md text eol=lf
