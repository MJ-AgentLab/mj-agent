# sdd/templates/contracts/compose.contract.yml.template
# Copy to capabilities/infrastructure/docker-compose/contracts/compose.contract.yml.
# Validated by scripts/sdd/check_docker_contracts.py (compose 子集；Phase M2 warning / M3 blocking).
#
# Skeleton template — Docker Compose 4-file 配置 contract.
# M1 evolution: M0-flat fields are reshaped into nested blocks (file_layering /
# invocation_contract / services / networks / volumes / postgres_init).

contract_id: <placeholder>                          # e.g. compose
covers_requirements:
  - <REQ-NNN>                                       # e.g. 4-file profile loading + healthcheck + env injection

# 4-file layering (ADR-026)
file_layering:
  base:
    path: docker/compose.yaml
    freeze_anchor: docker/compose.yaml (<N> lines)
    compose_project_name: <project-name>            # `name: <project>`; stable across profiles
  overlays:
    - profile: DEV
      path: docker/compose.override.yml
      freeze_anchor: docker/compose.override.yml (<N> lines)
      key_additions: "<dev-specific additions, e.g. build context + dev log level>"
    - profile: TEST
      path: docker/compose.test.yml
      freeze_anchor: docker/compose.test.yml (<N> lines)
      key_additions: "<test-specific additions, e.g. registry image + resource caps>"
    - profile: PROD
      path: docker/compose.prod.yml
      freeze_anchor: docker/compose.prod.yml (<N> lines)
      key_additions: "<prod-specific additions, e.g. resource caps + logging driver>"

# Invocation contract
invocation_contract:
  dev_command: |
    docker compose --env-file .env \
      -f docker/compose.yaml \
      -f docker/compose.override.yml up -d
  test_command: |
    docker compose --env-file .env \
      -f docker/compose.yaml \
      -f docker/compose.test.yml up -d
  prod_command: |
    docker compose --env-file .env \
      -f docker/compose.yaml \
      -f docker/compose.prod.yml up -d

  why_explicit_overlay:
    auto_load_disabled: "compose files in docker/ subdir; auto-load of override.yml only fires when CLI in same dir as the base compose file"
    explicit_f_overrides: "passing -f explicitly switches off auto-load even where it would have fired"

  why_env_file_explicit:
    project_directory_rule: "compose's `${VAR}` substitution reads .env from project_directory = directory of first -f file = docker/"
    repo_root_env_location: ".env lives at repo root, NOT in docker/"
    consequence_without_env_file: "${VAR:-sentinel} substitutes to sentinel; postgres init bakes sentinel into volume; connection fails with `password authentication failed`"

  dual_injection_mechanism:
    cli_substitution_layer:
      mechanism: "--env-file .env"
      purpose: "${VAR} substitution in compose YAML (before any container starts)"
    container_env_layer:
      mechanism: "env_file: ../.env  (inside service definition)"
      purpose: "inject env vars into running container"
    both_required: "CLI for compose substitution; container for runtime env; one alone insufficient"

# Services
services:

  <service-name>:
    image: <image:tag>                              # DEV may add build:; TEST/PROD may override to registry
    ports: ["<HOST>:<CONTAINER>"]
    env_file: ../.env
    environment:
      <ENV_KEY>: <value>
    depends_on:                                      # startup order
      <dependency-service>:
        condition: service_healthy
    healthcheck:
      cmd: "<healthcheck command>"
      interval: 30s
      start_period: 30s
      retries: 3
    networks:
      - <network-name>

# Networks
networks:
  <external-network>:
    external: true                                  # owned by another stack; this project only attaches
    purpose: "<why this external network is required, e.g. biz pg analyst RO; ADR-008>"
  <internal-network>:
    type: bridge
    labels:
      isolation: internal                            # security label

# Volumes
volumes:
  <volume-name>:
    labels:
      backup: <daily>

# Postgres init script (shell-safe contract)
postgres_init:
  path: docker/postgres-init/01-bootstrap-mj-agent-memory.sh
  freeze_anchor: docker/postgres-init/01-bootstrap-mj-agent-memory.sh (<N> lines)
  idempotency:
    role_handling: "CREATE ROLE if missing; ALTER ROLE if exists"
    database_handling: "CREATE DATABASE if missing"
    grants: "GRANT CONNECT + CREATE to <memory user>"
  shell_safety_pattern:
    heredoc: "<<-'EOSQL'"                            # single-quoted; disables bash expansion entirely
    env_read: "psql \\getenv reads env directly (no shell intermediary)"
    sql_escape: "format('%I %L', name, password)  -- I = identifier; L = literal"
    execution: "\\gexec executes the formatted DDL"
    handles: "passwords with $ / backticks / quotes / parens / spaces"

hitl_required:
  - prod compose change                             # compose.prod.yml any modification
                                                    # (per policies/docker-runtime.md §4)

