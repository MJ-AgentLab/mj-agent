# sdd/templates/contracts/docker.contract.yml.template
# Copy to capabilities/infrastructure/docker-compose/contracts/docker.contract.yml.
# Validated by scripts/sdd/check_docker_contracts.py (Phase M2 warning / M3 blocking).
#
# Skeleton template — Dockerfile lint + image security contract.
# M1 evolution: M0-flat fields are reshaped into nested blocks (dockerfile / base_image /
# builder_stage_contract / runtime_stage_contract / healthcheck / entrypoint_script).

contract_id: <placeholder>                          # e.g. docker
covers_requirements:
  - <REQ-NNN>                                       # e.g. image-layer constraints (no secrets baked)

dockerfile:
  path: infra/docker/Dockerfile                     # path → docker/... after the infra/docker→docker move (ADR-026, M5-PR2; rename per decision-a)
  freeze_anchor: infra/docker/Dockerfile (<N> lines)

base_image:
  builder_stage:
    image: <python:3.X-slim>                        # digest-pinned via Dependabot; tag comment authoritative on intent
    note: "<actual python version inside the pinned digest>"
    rationale: "Dependabot maintains digest pin; tag comment documents intent for human reviewers"
  runtime_stage:
    image: <python:3.X-slim>                         # same digest as builder
    note: "<runtime additions, e.g. libpq5 + tini>"

builder_stage_contract:
  build_args:
    <BUILD_ARG_NAME>:
      default: "<default value>"                    # informational; --build-arg override allowed
      semantics: "<what this build arg controls>"
  env:
    <ENV_KEY>: <value>                              # e.g. UV_PYTHON_PREFERENCE: only-system
  caching_strategy:
    layer_1: "<dependency layer description>"
    layer_2: "<source layer description>"

runtime_stage_contract:
  user:
    name: <appuser>
    uid: <NNNN>
    gid: <NNNN>
    non_root: true                                  # explicit USER directive; required by REQ
  tz: <Asia/Shanghai>
  init_process: <tini>                              # entrypoint via init wrapper
  exposed_port: 8000                                # mj-agent main port (Chainlit default)
  copied_paths_allowlist:
    - "/app/.venv (from builder)"
    - "/app/src"
    - "/app/pyproject.toml"
    - "<other copied path>"
  forbidden_in_image:                               # no secrets baked
    - ".env"
    - "config/secrets.enc"
    - "config/secrets-mcp.enc"
    - "private keys / ssh keys"
    - "API keys (no ARG with sensitive values)"
  env_defaults:                                     # non-sensitive defaults; safe in image
    <ENV_KEY>: "<value>"
  mkdir:
    - "<runtime dir to create>"
  entrypoint: ["<init>", "--", "<entrypoint script>"]
  cmd: ["<default subcommand>"]

healthcheck:
  cmd: "<healthcheck command>"                       # e.g. mj-agent check
  interval: 30s
  timeout: 10s
  start_period: 20s
  retries: 3
  semantics: "<what the healthcheck validates>"

entrypoint_script:
  path: infra/docker/entrypoint.sh                  # path → docker/... after the infra/docker→docker move (ADR-026, M5-PR2; rename per decision-a)
  freeze_anchor: infra/docker/entrypoint.sh (<N> lines)
  shebang_options: "set -Eeuo pipefail"
  subcommand_router:
    - "<subcommand> → <action>"
  contract:
    - "does NOT decrypt config/secrets.enc"          # no secrets baked
    - "orchestrator injects secrets via --env-file .env / Compose env / Docker secrets"

hitl_required:
  - none                                            # Dockerfile / entrypoint.sh changes are infra;
                                                    # but docker/compose.prod.yml mods → cross-cap HITL
                                                    # (per policies/docker-runtime.md)

