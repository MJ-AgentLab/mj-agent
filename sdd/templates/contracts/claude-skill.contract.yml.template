# sdd/templates/contracts/claude-skill.contract.yml.template
# Copy to capabilities/<domain>/<capability-slug>/contracts/claude-skill.contract.yml.
# Validated by scripts/sdd/check_claude_skill_contracts.py (Phase M2 warning / M3 blocking).
#
# Skeleton template — .claude/skills/ in-tree workflow SKILL contract.
#
# Schema design (Option B per HITL Gate-1 batch 2):
# - description: stored as description_hash (sha256 of UTF-8 description string) for drift
#   detection without prose in contract YAML (same pattern as body content_hash precedent)
# - body_section_heads: enumerated for structural drift detection
# - content_hash canonical algorithm: strip frontmatter via regex + LF normalize + SHA-256 UTF-8;
#   see runtime-skill.contract.yml.template header for the full canonical spec.

contract_id: <placeholder>                          # e.g. claude-skill
adapter: <adapter-slug>                             # per sdd/adapters/claude-code-skill.md (= claude-code-skill)
covers_requirements:
  - <REQ-NNN>                                       # which requirements these workflow SKILLs support

# namespace_pattern: M2 declarative-only; M3 V4 runtime enforce
namespace_pattern: "^mj-agent-<group>-[a-z-]+$"     # anchored regex (ADR-016 namespace)

family: <family>                                    # one of: flow | git | doc | runtime | infra (ADR-016)
schema_compliance: ADR-013-native                   # 2-field (name + description); NOT 13-field Agent_Side

skills:                                             # one entry per in-tree workflow SKILL (alphabetical)

  - file: .claude/skills/mj-agent-<group>-<verb>/SKILL.md
    name: mj-agent-<group>-<verb>                   # must match directory; conforms to namespace_pattern
    description_hash: sha256:<HEX>                   # sha256 of UTF-8 description string (drift proxy)
    body_content_hash: sha256:<HEX>                  # body sha256 (after frontmatter strip / LF normalize)
    frozen_at: <ISO-8601-timestamp>                 # e.g. 2026-06-03T00:00:00Z
    body_section_heads:                             # body required: ## Overview + ## Workflow (rest flexible)
      - "## Overview"
      - "## Workflow"
      # ... enumerate the remaining body section heads for structural drift detection

hitl_required:
  - <placeholder>                                   # e.g. mcp-server-trust-posture-change
                                                    # canonical enum per policies/ai-agent.md §4 (hyphen canonical)
