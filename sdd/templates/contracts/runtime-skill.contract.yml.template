# sdd/templates/contracts/runtime-skill.contract.yml.template
# Copy to capabilities/<domain>/<capability-slug>/contracts/runtime-skill.contract.yml.
# Validated by scripts/sdd/check_runtime_skill_contracts.py (Phase M2 起 + A11 PR gate 联动).
#
# Skeleton template — In-source canonical SKILL.md contract.
# M2 evolution: a capability may freeze MULTIPLE in-source SKILLs, so the canonical
# shape is a `skills[]` collection (the M0 single `skill_path` form is superseded).
# See sdd/adapters/runtime-skill.md §Standards.
#
# content_hash canonical algorithm (must match check_runtime_skill_contracts.py):
#   1. Read SKILL.md as UTF-8.
#   2. Strip YAML frontmatter via regex (?ms)^---\r?\n.*?\r?\n---\r?\n (count=1).
#   3. Normalize line endings to LF (\r\n / \r → \n).
#   4. SHA-256 over the resulting UTF-8 body bytes; hex lowercase.

contract_id: <placeholder>                          # e.g. runtime-skill
adapter: <adapter-slug>                             # per sdd/adapters/runtime-skill.md (= runtime-skill)
covers_requirements:
  - <REQ-NNN>                                       # which requirements this SKILL set covers

frontmatter_strip_contract: true                    # loader MUST strip frontmatter (Agent_Side §7.5)
loader: load_skill                                  # src.mj_agent.skills package

skills:                                             # M2 collection form; one entry per in-source SKILL

  - file: src/mj_agent/skills/<skill-name>/SKILL.md
    version: <vX.Y>                                 # frozen frontmatter version field
    state: active                                   # frozen frontmatter state field
    body_section_heads:                             # SKILL.md body 必含 6 段 (in body order after strip)
      - "## Purpose"
      - "## When to use"
      - "## Planning workflow"
      - "## Common patterns"
      - "## Anti-patterns"
      - "## Related"
    content_hash: sha256:<HEX>                       # body sha256 (after frontmatter strip)
    frozen_at: <ISO-8601-timestamp>                 # e.g. 2026-05-21T00:00:00Z
    variables: []                                   # static body; no template variables
    triggers_visible: []                            # mirrors frontmatter `triggers_visible` (if present)
    used_by_agent: true                             # listed in _ACTIVE_SKILLS (agent.py)
    eval_references: []                              # M2 advisory; M4-FU baseline per ADR-024
    cross_skill_refs: []                            # mirrors frontmatter related_skills (e.g. biz-domain-context)

allowed_state_transitions:
  - draft → active                                  # requires eval_references non-empty (Phase 2+)
  - active → deprecated                             # requires superseded_by

hitl_required:
  - runtime-skill-content-change                    # any SKILL body / frontmatter change triggers
                                                    # canonical trigger description in sdd/gates.md §4
                                                    # (hyphen canonical per C5)
